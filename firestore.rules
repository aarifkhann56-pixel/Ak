rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidChatSession(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             data.mode is string &&
             data.mode in ['CHAT', 'APK_CODER', 'DEBUGGER', 'SUMMARIZER'] &&
             data.modelId is string &&
             data.modelId in ['gemini-3.8-flash', 'gemini-3.5-flash-lite', 'gemini-4-argon'] &&
             data.lastMessagePreview is string &&
             data.lastMessagePreview.size() <= 300 &&
             data.messageCount is int &&
             data.messageCount >= 0 &&
             data.messageCount <= 10000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidChatMessage(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.role is string &&
             data.role in ['USER', 'MODEL'] &&
             data.text is string &&
             data.text.size() >= 1 &&
             data.text.size() <= 50000 &&
             data.hasImage is bool &&
             (!('modelUsed' in data) || (data.modelUsed is string && data.modelUsed.size() >= 1 && data.modelUsed.size() <= 64)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    function isValidCodeSnippet(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             data.language is string &&
             data.language.size() >= 1 &&
             data.language.size() <= 32 &&
             data.code is string &&
             data.code.size() >= 1 &&
             data.code.size() <= 50000 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/chats/{chatId} {
      allow get: if isOwner(userId) && isValidId(chatId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(chatId) &&
                       incoming().keys().hasAll(['userId', 'title', 'mode', 'modelId', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'mode', 'modelId', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt']) &&
                       isValidChatSession(incoming(), userId);
      allow update: if isOwner(userId) &&
                       isValidId(chatId) &&
                       isValidChatSession(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'mode', 'modelId', 'lastMessagePreview', 'messageCount', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(chatId);

      match /messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(chatId) && isValidId(messageId);
        allow list: if isOwner(userId) && isValidId(chatId);
        allow create: if isOwner(userId) &&
                         isValidId(chatId) &&
                         isValidId(messageId) &&
                         incoming().keys().hasAll(['userId', 'role', 'text', 'hasImage', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'role', 'text', 'hasImage', 'modelUsed', 'createdAt']) &&
                         isValidChatMessage(incoming(), userId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(chatId) && isValidId(messageId);
      }
    }

    match /users/{userId}/snippets/{snippetId} {
      allow get: if isOwner(userId) && isValidId(snippetId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(snippetId) &&
                       incoming().keys().hasAll(['userId', 'title', 'language', 'code', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'language', 'code', 'notes', 'createdAt', 'updatedAt']) &&
                       isValidCodeSnippet(incoming(), userId);
      allow update: if isOwner(userId) &&
                       isValidId(snippetId) &&
                       isValidCodeSnippet(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'language', 'code', 'notes', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(snippetId);
    }
  }
}
